{
  "name": "@microsoft/learn-cli",
  "version": "1.0.0",
  "description": "CLI for the Microsoft Learn MCP server.",
  "type": "module",
  "bin": {
    "mslearn": "./dist/index.js"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "microsoft",
    "learn",
    "mcp",
    "cli",
    "azure",
    "docs"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoftdocs/mcp.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/microsoftdocs/mcp/issues"
  },
  "homepage": "https://github.com/microsoftdocs/mcp/tree/main/cli",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "commander": "^14.0.3",
    "env-paths": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
